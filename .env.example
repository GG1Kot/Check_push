# App
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_changes?schema=public
REDIS_URL=redis://localhost:6379

# GitHub
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
GITHUB_TOKEN=github_pat_replace_me

# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Approximate cost tracking; update if your model pricing changes.
OPENAI_INPUT_USD_PER_MILLION=0.20
OPENAI_OUTPUT_USD_PER_MILLION=1.20

# AI limits
AI_MAX_FILE_CHARS=16000
AI_MAX_GROUP_CHARS=36000
AI_MAX_TOTAL_CHARS=140000
AI_SEARCH_CANDIDATES=500

# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protect /api/cron/daily if you expose it publicly.
CRON_SECRET=replace-me
